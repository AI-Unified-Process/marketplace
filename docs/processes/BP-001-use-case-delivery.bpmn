<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BP-001" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_BP-001">
    <bpmn:participant id="Participant_Project" name="Project Team" processRef="BP-001" />
  </bpmn:collaboration>
  <bpmn:process id="BP-001" name="Use Case Delivery" isExecutable="false">
    <bpmn:documentation>Goal: A use case is specified, approved, implemented, and verified by tests that trace to it.
Trigger: The vision of a new system is written.
Requirements: FR-001, FR-002, FR-003, FR-005, FR-006, FR-007, FR-008, FR-009, FR-010, FR-015, FR-016, FR-017, FR-018, FR-019, FR-020, FR-022, FR-023
Status: Draft</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP-001">
      <bpmn:lane id="Lane_BusinessAnalyst" name="Business Analyst">
        <bpmn:flowNodeRef>StartEvent_VisionWritten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_WriteRequirementsCatalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CreateEntityModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CreateUseCaseDiagram</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ModelBusinessProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SpecifyUseCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReviewSpecification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReadyForApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SchemaChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Developer" name="Developer">
        <bpmn:flowNodeRef>Activity_CreateDatabaseMigration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ImplementUseCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecificationGap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_WriteUseCaseTests</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tester" name="Tester">
        <bpmn:flowNodeRef>Activity_WriteTestCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AutomateTestCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AuditCoverage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FullyCovered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_UseCaseTested</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_VisionWritten" name="Vision written" />
    <bpmn:userTask id="Activity_WriteRequirementsCatalog" name="UC-001 Write Requirements Catalog" />
    <bpmn:userTask id="Activity_CreateEntityModel" name="UC-002 Create Entity Model" />
    <bpmn:userTask id="Activity_CreateUseCaseDiagram" name="UC-003 Create Use Case Diagram" />
    <bpmn:userTask id="Activity_ModelBusinessProcess" name="UC-005 Model Business Process" />
    <bpmn:userTask id="Activity_SpecifyUseCase" name="UC-004 Specify Use Case" />
    <bpmn:userTask id="Activity_ReviewSpecification" name="UC-006 Review Specification" />
    <bpmn:exclusiveGateway id="Gateway_ReadyForApproved" name="Ready for Approved?" />
    <bpmn:exclusiveGateway id="Gateway_SchemaChange" name="Schema change needed?" />
    <bpmn:userTask id="Activity_CreateDatabaseMigration" name="UC-009 Create Database Migration" />
    <bpmn:userTask id="Activity_ImplementUseCase" name="UC-010 Implement Use Case" />
    <bpmn:exclusiveGateway id="Gateway_SpecificationGap" name="Specification gap found?" />
    <bpmn:userTask id="Activity_WriteUseCaseTests" name="UC-011 Write Use Case Tests" />
    <bpmn:userTask id="Activity_WriteTestCase" name="UC-012 Write Test Case" />
    <bpmn:userTask id="Activity_AutomateTestCase" name="UC-013 Automate Test Case" />
    <bpmn:userTask id="Activity_AuditCoverage" name="UC-014 Audit Coverage" />
    <bpmn:exclusiveGateway id="Gateway_FullyCovered" name="Fully covered?" />
    <bpmn:endEvent id="EndEvent_UseCaseTested" name="Use case tested" />
    <bpmn:sequenceFlow id="Flow_VisionWritten_WriteRequirementsCatalog" sourceRef="StartEvent_VisionWritten" targetRef="Activity_WriteRequirementsCatalog" />
    <bpmn:sequenceFlow id="Flow_WriteRequirementsCatalog_CreateEntityModel" sourceRef="Activity_WriteRequirementsCatalog" targetRef="Activity_CreateEntityModel" />
    <bpmn:sequenceFlow id="Flow_CreateEntityModel_CreateUseCaseDiagram" sourceRef="Activity_CreateEntityModel" targetRef="Activity_CreateUseCaseDiagram" />
    <bpmn:sequenceFlow id="Flow_CreateUseCaseDiagram_ModelBusinessProcess" sourceRef="Activity_CreateUseCaseDiagram" targetRef="Activity_ModelBusinessProcess" />
    <bpmn:sequenceFlow id="Flow_ModelBusinessProcess_SpecifyUseCase" sourceRef="Activity_ModelBusinessProcess" targetRef="Activity_SpecifyUseCase" />
    <bpmn:sequenceFlow id="Flow_SpecifyUseCase_ReviewSpecification" sourceRef="Activity_SpecifyUseCase" targetRef="Activity_ReviewSpecification" />
    <bpmn:sequenceFlow id="Flow_ReviewSpecification_ReadyForApproved" sourceRef="Activity_ReviewSpecification" targetRef="Gateway_ReadyForApproved" />
    <bpmn:sequenceFlow id="Flow_ReadyForApproved_Yes" name="yes" sourceRef="Gateway_ReadyForApproved" targetRef="Gateway_SchemaChange" />
    <bpmn:sequenceFlow id="Flow_ReadyForApproved_No" name="no" sourceRef="Gateway_ReadyForApproved" targetRef="Activity_SpecifyUseCase" />
    <bpmn:sequenceFlow id="Flow_SchemaChange_Yes" name="yes" sourceRef="Gateway_SchemaChange" targetRef="Activity_CreateDatabaseMigration" />
    <bpmn:sequenceFlow id="Flow_SchemaChange_No" name="no" sourceRef="Gateway_SchemaChange" targetRef="Activity_ImplementUseCase" />
    <bpmn:sequenceFlow id="Flow_CreateDatabaseMigration_ImplementUseCase" sourceRef="Activity_CreateDatabaseMigration" targetRef="Activity_ImplementUseCase" />
    <bpmn:sequenceFlow id="Flow_ImplementUseCase_SpecificationGap" sourceRef="Activity_ImplementUseCase" targetRef="Gateway_SpecificationGap" />
    <bpmn:sequenceFlow id="Flow_SpecificationGap_No" name="no" sourceRef="Gateway_SpecificationGap" targetRef="Activity_WriteUseCaseTests" />
    <bpmn:sequenceFlow id="Flow_SpecificationGap_Yes" name="yes" sourceRef="Gateway_SpecificationGap" targetRef="Activity_SpecifyUseCase" />
    <bpmn:sequenceFlow id="Flow_WriteUseCaseTests_WriteTestCase" sourceRef="Activity_WriteUseCaseTests" targetRef="Activity_WriteTestCase" />
    <bpmn:sequenceFlow id="Flow_WriteTestCase_AutomateTestCase" sourceRef="Activity_WriteTestCase" targetRef="Activity_AutomateTestCase" />
    <bpmn:sequenceFlow id="Flow_AutomateTestCase_AuditCoverage" sourceRef="Activity_AutomateTestCase" targetRef="Activity_AuditCoverage" />
    <bpmn:sequenceFlow id="Flow_AuditCoverage_FullyCovered" sourceRef="Activity_AuditCoverage" targetRef="Gateway_FullyCovered" />
    <bpmn:sequenceFlow id="Flow_FullyCovered_Yes" name="yes" sourceRef="Gateway_FullyCovered" targetRef="EndEvent_UseCaseTested" />
    <bpmn:sequenceFlow id="Flow_FullyCovered_No" name="no" sourceRef="Gateway_FullyCovered" targetRef="Activity_ImplementUseCase" />
  </bpmn:process>
